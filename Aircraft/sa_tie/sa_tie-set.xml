<PropertyList>
  <sim>
    <description>Space Arena TIE/ln — greybox viewer (no flight dynamics)</description>
    <author>Space Arena contributors; OpenAI Codex assisted</author>
    <aircraft-version>0.1.0</aircraft-version>
    <minimum-fg-version>2024.1.4</minimum-fg-version>
    <status>alpha</status>
    <flight-model>null</flight-model>
    <model><path>Aircraft/sa_tie/Models/tie.xml</path></model>
    <chase-distance-m type="double">-18</chase-distance-m>
    <startup><splash-title>TIE/ln greybox — static viewer only</splash-title></startup>
    <space-arena>
      <ship-id>tie</ship-id><team-id>empire</team-id>
      <visual>
        <throttle type="double">0.0</throttle>
        <tie-panel-light type="bool">false</tie-panel-light>
      </visual>
    </space-arena>
    <help>
      <line>Static greybox. FDM is null; there is no flight or multiplayer validation.</line>
      <line>v cycles views. In cockpit, click the ivory rocker on the right console.</line>
      <line>File / Browse Internal Properties: /sim/space-arena/visual/throttle (0..1).</line>
    </help>
    <!-- View offsets are camera axes: right, up, aft. Not model x/y/z! -->
    <view n="0">
      <name>TIE pilot</name><type>lookfrom</type><internal type="bool">true</internal>
      <config>
        <from-model type="bool">true</from-model><from-model-idx type="int">0</from-model-idx>
        <x-offset-m type="double">0</x-offset-m>
        <y-offset-m type="double">0.35</y-offset-m>
        <z-offset-m type="double">-0.25</z-offset-m>
        <heading-offset-deg type="double">0</heading-offset-deg>
        <pitch-offset-deg type="double">0</pitch-offset-deg>
        <roll-offset-deg type="double">0</roll-offset-deg>
        <default-field-of-view-deg type="double">80</default-field-of-view-deg>
        <ground-level-nearplane-m type="double">0.05</ground-level-nearplane-m>
      </config>
    </view>
    <view n="1">
      <name>TIE exterior front quarter</name><type>lookat</type><internal type="bool">false</internal>
      <config>
        <from-model type="bool">true</from-model><from-model-idx type="int">0</from-model-idx>
        <at-model type="bool">true</at-model><at-model-idx type="int">0</at-model-idx>
        <eye-heading-deg-path>/orientation/heading-deg</eye-heading-deg-path>
        <eye-pitch-deg-path>/orientation/pitch-deg</eye-pitch-deg-path>
        <eye-roll-deg-path>/orientation/roll-deg</eye-roll-deg-path>
        <x-offset-m type="double">13</x-offset-m>
        <y-offset-m type="double">8</y-offset-m>
        <z-offset-m type="double">-18</z-offset-m>
        <heading-offset-deg type="double">180</heading-offset-deg>
        <default-field-of-view-deg type="double">45</default-field-of-view-deg>
        <ground-level-nearplane-m type="double">0.1</ground-level-nearplane-m>
      </config>
    </view>
    <view n="2">
      <name>TIE exterior engines</name><type>lookat</type><internal type="bool">false</internal>
      <config>
        <from-model type="bool">true</from-model><from-model-idx type="int">0</from-model-idx>
        <at-model type="bool">true</at-model><at-model-idx type="int">0</at-model-idx>
        <eye-heading-deg-path>/orientation/heading-deg</eye-heading-deg-path>
        <eye-pitch-deg-path>/orientation/pitch-deg</eye-pitch-deg-path>
        <eye-roll-deg-path>/orientation/roll-deg</eye-roll-deg-path>
        <x-offset-m type="double">9</x-offset-m>
        <y-offset-m type="double">5</y-offset-m>
        <z-offset-m type="double">18</z-offset-m>
        <heading-offset-deg type="double">180</heading-offset-deg>
        <default-field-of-view-deg type="double">45</default-field-of-view-deg>
        <ground-level-nearplane-m type="double">0.1</ground-level-nearplane-m>
      </config>
    </view>
    <view n="3">
      <name>TIE panel light switch</name><type>lookfrom</type><internal type="bool">true</internal>
      <config>
        <from-model type="bool">true</from-model><from-model-idx type="int">0</from-model-idx>
        <x-offset-m type="double">0</x-offset-m>
        <y-offset-m type="double">0.35</y-offset-m>
        <z-offset-m type="double">-0.25</z-offset-m>
        <heading-offset-deg type="double">-53</heading-offset-deg>
        <pitch-offset-deg type="double">-51</pitch-offset-deg>
        <roll-offset-deg type="double">0</roll-offset-deg>
        <default-field-of-view-deg type="double">60</default-field-of-view-deg>
        <ground-level-nearplane-m type="double">0.05</ground-level-nearplane-m>
      </config>
    </view>
  </sim>
</PropertyList>
